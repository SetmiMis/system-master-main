# Copy to .env.local and fill in. Never commit .env.local.
# Supabase project URL and the PUBLISHABLE (anon) key only. No service-role key is used anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public canonical origin of the deployed site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional live sources (server-only, never exposed to the browser)
E2O_METRICS_URL=
E2O_METRICS_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
